# listmonk — configuracion minima
# cp .env.example .env y rellena. NO subir el .env real.

# Postgres del panel
POSTGRES_PASSWORD=cambia-esto-por-una-larga-aleatoria
LISTMONK_ADMIN_USER=listmonk
LISTMONK_ADMIN_PASS=cambia-esto-por-una-larga-aleatoria

# SMTP para enviar (el mismo servidor o un proveedor)
SMTP_HOST=smtp.tu-servidor.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=clave

{
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "terser": "^5.51.2",
    "vitest": "^5.0.1"
  },
  "name": "43.-web-cha0smagick-labs",
  "version": "1.0.0",
  "description": "Static website for Cha0smagick Labs, blending occultism and technology.",
  "main": "sw.js",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "node-telegram-bot-api": "^1.2.0",
    "playwright": "^1.62.0",
    "puppeteer": "^25.4.0"
  },
  "scripts": {
    "test": "pytest scripts/ && vitest run scripts/bots/test/ scripts/social/test/ scripts/affiliate/test/ scripts/analytics/test/",
    "build:js": "esbuild js/affiliate.js js/app-render.js js/apps-data.js js/conversion.js js/price-locale.js js/shared.js js/visitor-map.js --minify --outdir=js --out-extension:.js=.min.js --target=es2020",
    "build:css": "cleancss -o css/style.min.css css/style.css",
    "prebuild": "npm run build:js",
    "build": "npm run build:css",
    "bot:telegram": "node scripts/bots/telegram-bot.js",
    "bot:discord": "node scripts/bots/discord-bot.js",
    "bot:all": "node scripts/bots/run-bots.js all",
    "bot:start": "node scripts/bots/run-bots.js all",
    "social:daily": "node scripts/social-publish.js daily",
    "social:dry": "node scripts/social-publish.js daily --dry-run",
    "social:selftest": "node scripts/social-publish.js selftest",
    "analytics:health": "node scripts/analytics-health.js",
    "analytics:health:save": "node scripts/analytics-health.js --save",
    "analytics:smoke": "node scripts/analytics-live-smoke.js",
    "analytics:daily": "node scripts/analytics-daily.js --dry-run",
    "analytics:daily:live": "node scripts/analytics-daily.js --live"
  },
  "repository": {
    "type": "git",

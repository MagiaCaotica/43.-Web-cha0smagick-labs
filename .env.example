# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL=@cha0smagicklabs
TELEGRAM_GROUP_INVITE=https://t.me/+krfQJgro4hBkNTE5

# ── Discord ──
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── Groq AI (Q&A for both bots — get key at console.groq.com) ──
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── GitHub (support ticket bot 3.1.11 → Issues) ──
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# ── Error tracking 3.1.7 (opcional — Sentry o GlitchTip autohospedado) ──
# SENTRY_DSN=https://<publicKey>@<host>/<projectId>
# GLITCHTIP_DSN=https://<publicKey>@<host>/<projectId>

# ── Social publishing 3.3 (opcional — publishers degradan sin estas vars) ──
# Pinterest API v5 directa (token con scopes pins:write; board ID numérico de la API)
# PINTEREST_TOKEN=pins_your_pinterest_token_here
# PINTEREST_BOARD_ID=1234567890123456789
# Bridge aggregator (Post Bridge / Ayrshare-style). OJO: api.post-bridge.com devolvió
# 404 públicamente (2026-09-21); setear solo si tienes acceso verificado al endpoint.
# POST_BRIDGE_KEY=pb_live_your_key_here
# POST_BRIDGE_URL=https://api.post-bridge.com/v1

# ── Play sales report 2.4.8 (daily Play Console financial CSV → Make.com → Sheets → MailerLite) ──
# Directory containing the Play Console financial-report CSVs the owner exports manually
# (Play Console → Download reports → Financial → CSV).
# PLAY_SALES_CSV_DIR=
# Make.com scenario URL that appends the daily summary to Google Sheets and triggers MailerLite.
# PLAY_SALES_WEBHOOK_URL=
# Optional HMAC secret; when set the POST carries X-Webhook-Signature: sha256=<hex>
# (see scripts/play-sales-report.py).
# PLAY_SALES_WEBHOOK_SECRET=

# ── Inner Circle 2.4.9 (invitación VIP Telegram + email vía Make.com) ──
# chat_id numérico del grupo VIP; seteado → enlace de un solo uso vía Bot API
# createChatInviteLink (más seguro que el enlace estático TELEGRAM_GROUP_INVITE).
# INNER_CIRCLE_CHAT_ID=
# Escenario Make.com que envía el email de invitación (Make → MailerLite).
# INNER_CIRCLE_WEBHOOK_URL=
# HMAC opcional; el POST lleva X-Webhook-Signature: sha256=<hex>
# INNER_CIRCLE_WEBHOOK_SECRET=

# ── Affiliate payout calculator 2.5.1 (comisiones → Make.com → Sheets → email) ──
# Ruta del CSV de conversiones de afiliados (o flag --conversions).
# AFFILIATE_CONVERSIONS_CSV=
# Escenario Make.com (Sheets + email mensual de pagos).
# AFFILIATE_PAYOUT_WEBHOOK_URL=
# HMAC opcional; el POST lleva X-Webhook-Signature: sha256=<hex>
# AFFILIATE_PAYOUT_WEBHOOK_SECRET=

# ── Revenue alerting 2.6.3 (Apps Script / cron → Telegram admin) ──
# Objetivo diario de ingresos USD (requerido en modo live).
# REVENUE_DAILY_TARGET=
# Fracción del objetivo que dispara la alerta (default 0.5 = dispara bajo el 50%).
# REVENUE_ALERT_THRESHOLD=0.5
# Chat ID numérico del admin que recibe la alerta (Bot API sendMessage).
# TELEGRAM_ADMIN_CHAT_ID=

# ── SEO revenue attribution 2.6.2 (GA4 Data API → keyword → revenue; scripts/seo-revenue-attribution.js) ──
# Live ga4 mode needs a Google service account via ADC (Google Cloud → IAM → Service
# Accounts) with read access to the GA4 property. Credentials are a later user activation.
# GOOGLE_APPLICATION_CREDENTIALS=
# GA4 property ID (bare number, e.g. 123456789)
# GA4_PROPERTY_ID=
# Days back to aggregate (default: 28)
# SEO_REVENUE_DAYS=
# Optional webhook that receives the summary JSON; when the secret is set the POST
# carries X-Webhook-Signature: sha256=<hex> (see scripts/seo-revenue-attribution.js).
# SEO_REVENUE_WEBHOOK_URL=
# SEO_REVENUE_WEBHOOK_SECRET=

# ── Cohort analysis 2.6.4 (MailerLite export + sales CSV → monthly cohort pivot → Make.com → Sheets) ──
# MailerLite subscribers export CSV (tolerant to column variants: email,
# subscribe_date/created_at, status, optional purchase/conversion fields).
# COHORT_SUBSCRIBERS_CSV=
# Optional sales/conversions CSV (columns: email, amount, date) attaching
# revenue to cohorts (emails missing from it get 0 revenue).
# COHORT_SALES_CSV=
# Make.com scenario URL that appends the cohort summary to Google Sheets.
# COHORT_WEBHOOK_URL=
# Optional HMAC secret; when set the POST carries X-Webhook-Signature: sha256=<hex>
# (see scripts/cohort-analysis.py).
# COHORT_WEBHOOK_SECRET=

# ── Play RTDN webhook 2.4.7 (R7) — Cloud Function → Make.com ──
# deploy/cloud-function/rtdn-to-make (suscripciones + compras anuladas; ventas one-time → 2.4.8)
RTDN_MAKE_WEBHOOK_URL=
RTDN_MAKE_WEBHOOK_SECRET=
# PLAY_PACKAGE_NAMES: allowlist opcional, paquetes separados por coma
PLAY_PACKAGE_NAMES=


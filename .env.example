# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL=@cha0smagicklabs
TELEGRAM_GROUP_INVITE=https://t.me/+krfQJgro4hBkNTE5

# ── Discord ──
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── Groq AI (Q&A for both bots — get key at console.groq.com) ──
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── GitHub (support ticket bot 3.1.11 → Issues) ──
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# ── Error tracking 3.1.7 (opcional — Sentry o GlitchTip autohospedado) ──
# SENTRY_DSN=https://<publicKey>@<host>/<projectId>
# GLITCHTIP_DSN=https://<publicKey>@<host>/<projectId>

# ── Social publishing 3.3 (opcional — publishers degradan sin estas vars) ──
# Pinterest API v5 directa (token con scopes pins:write; board ID numérico de la API)
# PINTEREST_TOKEN=pins_your_pinterest_token_here
# PINTEREST_BOARD_ID=1234567890123456789
# Bridge aggregator (Post Bridge / Ayrshare-style). OJO: api.post-bridge.com devolvió
# 404 públicamente (2026-09-21); setear solo si tienes acceso verificado al endpoint.
# POST_BRIDGE_KEY=pb_live_your_key_here
# POST_BRIDGE_URL=https://api.post-bridge.com/v1
